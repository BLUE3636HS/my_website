# Google Calendar OAuth 2.0 credentials for the shared TEKNE Google account.
# Never commit real values. GOOGLE_CALENDAR_ID may be "primary".
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Neon PostgreSQL connection string. Set DATABASE_URL in the environment; never commit a real value.
DATABASE_URL=
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
STORAGE_BUCKET=uploads
