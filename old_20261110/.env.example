# main/ (SQLite) environment variables.
# Copy this file to main/.env and replace values as needed.
# Never commit real credentials.

# Required only for Google Meet links created for mentor reservations.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Optional. If omitted, main/database/.session_secret is generated and reused.
# If set, use a secret with at least 32 characters.
SESSION_SECRET=
